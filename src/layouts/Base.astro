---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/switzer-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import gsap from 'gsap';

      const reveals = Array.from(document.querySelectorAll('.reveal'));
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const showAll = () => reveals.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });

      try {
        if (reduce || !reveals.length || !('IntersectionObserver' in window)) {
          showAll();
        } else {
          gsap.set(reveals, { opacity: 0, y: 18 });
          // IntersectionObserver triggers; GSAP animates. Items entering together stagger as a group.
          const io = new IntersectionObserver((entries) => {
            const hits = entries.filter((e) => e.isIntersecting).map((e) => e.target);
            if (!hits.length) return;
            gsap.to(hits, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.08, overwrite: true });
            hits.forEach((t) => io.unobserve(t));
          }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
          reveals.forEach((el) => io.observe(el));
        }
      } catch (e) {
        console.error('motion init failed', e);
        showAll();
      }
    </script>
  </body>
</html>
