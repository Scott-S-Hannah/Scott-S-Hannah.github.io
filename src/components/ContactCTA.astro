---
import { email } from '../data/site';
---
<section id="contact" class="cta">
  <div class="container cta__inner">
    <p class="cta__status reveal"><span class="cta__dot" aria-hidden="true"></span>Open to collaboration</p>
    <h2 class="cta__title reveal">Let&rsquo;s work together<span aria-hidden="true">.</span></h2>
    <p class="cta__line reveal">For research partnerships, applied physiology, and PhD supervision.</p>
    <div class="cta__contact reveal">
      <a class="cta__email" href={`mailto:${email}`}>{email}</a>
    </div>
    <p class="cta__creds reveal"><span>Fellow, Higher Education Academy</span><span aria-hidden="true" class="cta__sep"> · </span><span>Full Member, The Physiological Society</span></p>
  </div>
</section>

<style>
  .cta { background: var(--feature); color: var(--on-feature); padding-block: clamp(4rem, 3rem + 6vw, 8rem); }
  .cta__status { display: flex; align-items: center; gap: 9px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-feature-mut); font-weight: 500; }
  .cta__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal-bright); }
  .cta__title { color: var(--on-feature); font-size: var(--step-3); font-weight: 700; letter-spacing: -0.03em; margin: 1rem 0 0; }
  .cta__title span { color: var(--teal-bright); }
  .cta__line { color: var(--on-feature-mut); font-size: var(--step-1); line-height: 1.45; margin-top: 1.2rem; max-width: 40ch; }
  .cta__contact { margin-top: clamp(2rem, 4vw, 3.2rem); }
  .cta__email { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; color: var(--on-feature); border-bottom: 1px solid rgba(238,241,243,0.32); padding-bottom: 4px; }
  .cta__email:hover { color: var(--teal-bright); border-color: var(--teal-bright); }
  .cta__creds { color: var(--on-feature-faint); font-size: var(--step--1); margin-top: clamp(2rem, 4vw, 3rem); max-width: 60ch; line-height: 1.6; }
  .cta__creds span { white-space: nowrap; }
  @media (max-width: 42rem) { .cta__creds span:not(.cta__sep) { display: block; } .cta__sep { display: none; } }   /* stacked on phones: no orphaned separator */
  @media (max-width: 42rem) { .cta__email { font-size: var(--step-1); word-break: break-word; } }
</style>
