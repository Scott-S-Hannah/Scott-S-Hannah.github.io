---
/* A numbered ledger of offers: index numeral, title with the teal full stop,
   outcome-led description. One low-friction CTA closes the section.
   No logos, no partner walls; the ask itself does the selling. */
const email = 'Scott.Hannah@Winchester.ac.uk';
const offers = [
  { n: '01', t: 'Research consultancy', d: 'A study built to survive review: question, ethics, measurement, analysis, and the paper at the end of it.' },
  { n: '02', t: 'Performance support', d: 'Physiological testing and support infrastructure that produces numbers athletes and staff can act on.' },
  { n: '03', t: 'Guest lectures & talks', d: 'Teaching that makes physiology land, in lecture theatres, team rooms, and boardrooms.' },
];
---
<section id="consultancy" class="consult section">
  <div class="container">
    <div class="consult__head">
      <h2 class="consult__title reveal">Work with me</h2>
      <p class="consult__lede reveal">Consultancy through WinWell, for teams, clinicians, and organisations that need physiology they can act on.</p>
    </div>

    <div class="consult__svcs">
      {offers.map((s) => (
        <div class="consult__svc reveal">
          <span class="consult__n num" aria-hidden="true">{s.n}</span>
          <h3 class="consult__svc-t">{s.t}<span class="consult__dot" aria-hidden="true">.</span></h3>
          <p class="consult__svc-d">{s.d}</p>
        </div>
      ))}
    </div>

    <div class="consult__cta reveal">
      <a class="consult__btn" href={`mailto:${email}?subject=Working%20together`}>Start a conversation<span aria-hidden="true"> &nearr;</span></a>
      <a class="consult__email" href={`mailto:${email}?subject=Working%20together`}>{email}</a>
      <p class="consult__note">One email is enough to find out whether I can help.</p>
    </div>
  </div>
</section>

<style>
  .consult { background: var(--surface-2); border-block: 1px solid var(--line); }
  .consult__head { display: grid; grid-template-columns: 0.85fr 1.25fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .consult__title { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.025em; }
  .consult__lede { color: var(--mut); max-width: 44ch; line-height: 1.5; }

  .consult__svc {
    display: grid;
    grid-template-columns: clamp(3rem, 6vw, 5.5rem) minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.6rem, 2.8vw, 2.6rem);
    border-top: 1px solid var(--line-strong);
  }
  .consult__n { font-size: var(--step-2); font-weight: 700; line-height: 1; color: var(--faint); letter-spacing: -0.02em; }
  .consult__svc-t { font-size: clamp(1.35rem, 1.05rem + 1.4vw, 2rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; }
  .consult__dot { color: var(--teal); }
  .consult__svc-d { color: var(--mut); font-size: var(--step-0); line-height: 1.5; max-width: 46ch; }

  .consult__cta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem 1.8rem;
    margin-top: clamp(2rem, 4vw, 3rem); padding-top: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--line-strong);
  }
  .consult__btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--ink); color: var(--paper);
    font-size: var(--step-0); font-weight: 600; letter-spacing: -0.01em;
    padding: 0.95rem 1.6rem; border-radius: 2px;
    transition: background 0.25s ease;
  }
  .consult__btn:hover { background: var(--teal-deep); color: var(--paper); }
  .consult__email {
    color: var(--ink); font-weight: 500; font-size: var(--step-0);
    border-bottom: 1px solid var(--line-strong); padding-bottom: 2px;
  }
  .consult__email:hover { color: var(--teal-deep); border-color: var(--teal-deep); }
  .consult__note { color: var(--mut); font-size: var(--step--1); flex-basis: 100%; }

  @media (max-width: 52rem) {
    .consult__head { grid-template-columns: 1fr; gap: 1rem; align-items: start; }
    .consult__lede { max-width: none; }
    .consult__svc { grid-template-columns: clamp(2.4rem, 9vw, 3rem) minmax(0, 1fr); gap: 0.4rem 1rem; }
    .consult__n { font-size: var(--step-1); }
    .consult__svc-d { grid-column: 2; }
  }
</style>
