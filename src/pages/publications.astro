---
import Base from '../layouts/Base.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { byYearDesc, AREAS, areaOf } from '../lib/publications';
import { profiles } from '../data/site';

const areaKeys = Object.keys(AREAS).filter((a) => byYearDesc.some((p) => areaOf(p.theme) === a));
const countOf = (a: string) => byYearDesc.filter((p) => areaOf(p.theme) === a).length;
const years = [...new Set(byYearDesc.map((p) => p.year))];
const groups = years.map((y) => ({ year: y, pubs: byYearDesc.filter((p) => p.year === y) }));

/* Structured data: the scholar and the works. This is how a Google search on
   the name or a paper title learns the archive is the canonical hub. */
const personId = new URL('/#person', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Dr Scott Hannah',
      jobTitle: 'Exercise Physiologist',
      url: Astro.site?.href,
      sameAs: profiles.map((p) => p.href),
    },
    ...byYearDesc.map((p) => ({
      '@type': 'ScholarlyArticle',
      headline: p.title,
      author: p.authors.map((a) =>
        a.isOwner ? { '@id': personId } : { '@type': 'Person', name: a.name },
      ),
      datePublished: p.year ? String(p.year) : undefined,
      publisher: p.journal,
      sameAs: p.doi ? `https://doi.org/${p.doi}` : undefined,
      abstract: p.abstract || undefined,
    })),
  ],
};
---
<Base title="Publications | Dr Scott Hannah" description="Journal papers and conference abstracts by Dr Scott Hannah on cardiovascular physiology, clinical exercise rehabilitation, and athlete health.">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section container">
    <p class="kicker">Publications</p>
    <h1 class="pubs__head">Papers and abstracts<span aria-hidden="true">.</span></h1>

    <div class="filters" role="group" aria-label="Filter publications by area of focus">
      <button class="filter is-active" data-filter="all" aria-pressed="true">All<span class="filter__n num">{byYearDesc.length}</span></button>
      {areaKeys.map((a) => (
        <button class="filter" data-filter={a} aria-pressed="false">{AREAS[a].label}<span class="filter__n num">{countOf(a)}</span></button>
      ))}
    </div>

    <div id="pub-list">
      {groups.map((g) => (
        <section class="pubyear">
          <h2 class="pubyear__y num">{g.year ?? 'In press'}</h2>
          <div class="pubyear__items">
            {g.pubs.map((pub) => <PublicationItem pub={pub} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .pubs__head { font-size: var(--step-3); margin-top: 0.4rem; margin-bottom: 2rem; }
  .pubs__head span { color: var(--teal); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .filter {
    display: inline-flex; align-items: baseline; gap: 0.55rem;
    font-family: var(--font-body); font-size: var(--step--1); color: var(--mut);
    background: transparent; border: 1px solid var(--line-strong); border-radius: 2px;
    padding: 0.45rem 0.85rem; cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .filter__n { font-size: 0.85em; color: var(--faint); transition: color 0.2s ease; }
  .filter:hover { border-color: var(--teal); color: var(--teal-deep); }
  .filter.is-active { background: var(--teal-deep); color: var(--paper); border-color: var(--teal-deep); }
  .filter.is-active .filter__n { color: var(--teal-wash); }

  .pubyear {
    display: grid; grid-template-columns: clamp(5rem, 10vw, 8rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(1.2rem, 2.5vw, 2rem) 0.6rem;
  }
  .pubyear__y {
    font-size: var(--step-3); font-weight: 700; line-height: 0.9; letter-spacing: -0.03em;
    color: var(--ink); position: sticky; top: calc(var(--nav-h) + 1.2rem); align-self: start;
  }
  @media (max-width: 40rem) {
    .pubyear { grid-template-columns: 1fr; gap: 0.4rem; }
    .pubyear__y { position: static; font-size: var(--step-2); }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('#pub-list .pub');
  const groups = document.querySelectorAll<HTMLElement>('#pub-list .pubyear');

  const apply = (filter: string) => {
    buttons.forEach((b) => {
      const active = b.dataset.filter === filter;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    items.forEach((item) => {
      const show = filter === 'all' || item.dataset.area === filter;
      item.style.display = show ? '' : 'none';
    });
    groups.forEach((g) => {   // a year with nothing left in it disappears with its numeral
      const any = Array.from(g.querySelectorAll<HTMLElement>('.pub')).some((i) => i.style.display !== 'none');
      g.style.display = any ? '' : 'none';
    });
  };

  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter ?? 'all';
    apply(f);
    // Filters live in the URL, so a filtered view can be shared, bookmarked, and indexed.
    const url = new URL(location.href);
    if (f === 'all') url.searchParams.delete('area'); else url.searchParams.set('area', f);
    history.replaceState(null, '', url);
  }));

  // Deep link from the Research section: /publications?area=mechanisms
  const wanted = new URLSearchParams(location.search).get('area');
  if (wanted && Array.from(buttons).some((b) => b.dataset.filter === wanted)) apply(wanted);

  // Copy citation: clipboard write with a brief inline confirmation.
  document.querySelectorAll<HTMLButtonElement>('.pub__cite').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.citation ?? '');
        const was = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = was; }, 1600);
      } catch { /* clipboard unavailable (http, permissions): leave the button as-is */ }
    });
  });
</script>
